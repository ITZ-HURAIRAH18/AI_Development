# MongoDB Atlas connection string
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=

DATABASE_NAME=HealthCare_Appointment

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend URLs (comma-separated or single URL)
# Local: http://localhost:5173
# Vercel: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# Optional: Vercel frontend URL for CORS (set in Vercel dashboard)
# VERCEL_FRONTEND_URL=https://your-frontend.vercel.app
